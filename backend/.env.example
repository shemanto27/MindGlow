# -------------------------------
# Django General Settings
# -------------------------------
DEBUG=False
SECRET_KEY=django-insecure-MindGlow-Production-Stable-Fix-2026
ALLOWED_HOSTS=ip,api.mindglow.tech,localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=https://api.mindglow.tech,http://localhost:3000

# -------------------------------
# Database Settings (RDS Postgres)
# -------------------------------
DB_ENGINE=django.db.backends.postgresql
DB_NAME=MindGlowdb
DB_USER=mindglow_db
DB_PASSWORD=
DB_HOST=
DB_PORT=5432

# -------------------------------
# AWS S3 Storage Settings
# -------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=mindglow-media-prod
AWS_S3_REGION_NAME=ca-central-1
AWS_S3_VERIFY=True

# -------------------------------
# Email Configuration (SMTP)
# -------------------------------
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# -------------------------------
# Sentry (Optional for monitoring)
# -------------------------------
SENTRY_DSN=

# -------------------------------
# CI/CD Image Selection
# -------------------------------
DOCKER_IMAGE=username/mindglow-backend:latest

# -------------------------------
# Superuser Credentials
# -------------------------------
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@gmail.com
DJANGO_SUPERUSER_PASSWORD=admin123


# ---------------------------------
# AI Related
# ---------------------------------
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
MAX_CONTEXT_MESSAGES=20
SIMILARITY_THRESHOLD=0.75
YOUTUBE_API_KEY=